# Wavly WiFi — environment (set in Vercel → Project → Settings → Environment Variables)
# DATABASE_URL: Supabase → Project Settings → Database → Connection string.
#   Use the SESSION pooler (port 5432) for simplicity, or transaction pooler (6543) for best serverless fit.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Router sync (mikrotik/*.rsc) — generate: openssl rand -hex 32
ROUTER_SYNC_KEY=

# Paystack (Dashboard → Settings → API Keys & Webhooks; webhook signature uses the SAME secret key)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# Arkesel SMS — leave ARKESEL_API_KEY empty in development to log SMSes instead of sending
ARKESEL_API_KEY=
ARKESEL_SENDER=WAVLY
SMS_DEV_LOG=true

# Cron authentication (Supabase pg_net and/or Vercel Cron) — generate: openssl rand -hex 24
CRON_SECRET=

# Admin login-flow HMAC key (pending 2FA tokens) — generate: openssl rand -hex 32
AUTH_SECRET=

# Optional: set to 'production' in Vercel (cookies get Secure flag automatically)
NODE_ENV=development
